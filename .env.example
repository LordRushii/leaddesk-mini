# Used only once by pnpm seed:admin to bootstrap the first admin account.
# Never commit real values for these variables.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional local-only autofill for project verification. Never use in production.
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@leaddesk.com
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=replace-with-the-local-demo-password
